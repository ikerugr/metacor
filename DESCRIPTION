Package: metacor
Type: Package
Title: Meta-Analytic Effect Size Calculation for Pre-Post Designs with Correlation Imputation
Version: 1.1.0
Authors@R: C(person(given = c("Iker", "J."),
                  family = "Bautista",
                  role = c("cre"),
                  email = "ikerugr@gmail.com"),
             person(given = c("Saul"),
                  family = "Martínez-Rodríguez",
                  role = c("aut"),
